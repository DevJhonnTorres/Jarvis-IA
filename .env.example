# Hermes Telegram Bot Configuration
# Copia este archivo a .env y rellena con tus datos

# Token del bot de Telegram (obtén de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Opcional: URL de API de Hermes (si usas API remota)
# HERMES_API_URL=https://api.hermes.local

# Opcional: Nivel de log (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
